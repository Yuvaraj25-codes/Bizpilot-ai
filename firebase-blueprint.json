{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Root workspace settings and metadata owned by an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the workspace owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "description": "Display name of the business workspace.",
          "minLength": 1,
          "maxLength": 120
        },
        "currency": {
          "type": "string",
          "description": "ISO currency code used for formatting.",
          "enum": ["USD", "EUR", "GBP", "INR"]
        },
        "publicMode": {
          "type": "boolean",
          "description": "Whether Privacy Shield masks sensitive financial and customer data."
        },
        "telemetryAlerts": {
          "type": "boolean",
          "description": "Whether in-app low-stock and order alerts are enabled."
        },
        "lowStockDefault": {
          "type": "integer",
          "description": "Default low-stock alert threshold for new products."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when workspace was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when workspace was last updated."
        }
      },
      "required": [
        "ownerId",
        "businessName",
        "currency",
        "publicMode",
        "telemetryAlerts",
        "lowStockDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "PrivateProfile": {
      "title": "PrivateProfile",
      "description": "Isolated PII profile record for the authenticated workspace owner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "displayName", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory catalog item with SKU, pricing, and stock thresholds.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "costPrice": {
          "type": "number"
        },
        "retailPrice": {
          "type": "number"
        },
        "stockQty": {
          "type": "integer"
        },
        "lowStockThreshold": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "sku",
        "name",
        "category",
        "costPrice",
        "retailPrice",
        "stockQty",
        "lowStockThreshold",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer sales order containing bounded line items and totals.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "cancelled"]
        },
        "items": {
          "type": "array",
          "description": "Bounded list of order line items (max 25)."
        },
        "totalAmount": {
          "type": "number"
        },
        "totalCost": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "orderNumber",
        "customerName",
        "customerPhone",
        "status",
        "items",
        "totalAmount",
        "totalCost",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense ledger record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": [
            "Payroll",
            "Marketing",
            "Logistics",
            "Software",
            "Utilities",
            "Inventory Restock",
            "Other"
          ]
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "category",
        "amount",
        "date",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Customer invoice record with tax calculation and status.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 40
        },
        "customerEmail": {
          "type": "string",
          "maxLength": 254
        },
        "items": {
          "type": "array",
          "description": "Bounded list of invoice line items (max 25)."
        },
        "subtotal": {
          "type": "number"
        },
        "taxRate": {
          "type": "number"
        },
        "taxAmount": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "sent", "paid"]
        },
        "issuedAt": {
          "type": "string",
          "maxLength": 40
        },
        "dueDate": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "invoiceNumber",
        "orderId",
        "customerName",
        "customerPhone",
        "customerEmail",
        "items",
        "subtotal",
        "taxRate",
        "taxAmount",
        "totalAmount",
        "status",
        "issuedAt",
        "dueDate",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Root workspace configuration document for an authenticated user."
    },
    "/users/{userId}/private/{profileId}": {
      "schema": { "$ref": "#/entities/PrivateProfile" },
      "description": "Isolated private PII profile document for the user."
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "User-owned inventory products."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "User-owned customer sales orders."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "User-owned operating expenses."
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "User-owned customer invoices."
    }
  }
}
